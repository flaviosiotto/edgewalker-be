  "lessons": [
    {
      "lesson": "Nelle fasi laterali l'incrocio delle medie genera molti falsi segnali: il filtro sul timeframe superiore riduce le operazioni ma non le elimina. Valuta di aggiungere un filtro di volatilità (ATR minimo).",
      "confidence": 0.6
    },
    {
      "lesson": "Un rapporto take profit / stop loss di 2:1 in ATR regge solo se la percentuale di vincita resta sopra il 35-40%: controllalo nel report del backtest prima di andare live.",
      "confidence": 0.5
    }
  ]
