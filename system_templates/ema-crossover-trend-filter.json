      "rules": [
        {
          "name": "long_su_incrocio_rialzista",
          "action": "buy",
          "chart_id": "main",
          "logic": "and",
          "size": 1,
          "conditions": [
            {
              "field": "ema20",
              "op": "crossing_up",
